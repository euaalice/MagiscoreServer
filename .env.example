# Configurações do Servidor
PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://seu_usuario:sua_senha@cluster.mongodb.net/

# JWT Secret
JWT_SECRET=seu_jwt_secret_aqui_mude_isso

# Session Secret
SESSION_SECRET=seu_session_secret_aqui_mude_isso

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:8080/server/auth/google/callback

# Frontend URL (para redirecionamento após login)
FRONTEND_URL=http://localhost:3000
